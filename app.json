{
  "expo": {
    "name": "Stemify Pro",
    "slug": "stemify-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "stemifypro",
    "splash": {
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stemify.pro",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Stemify Pro needs microphone access to analyze live music.",
        "NSAppleMusicUsageDescription": "Stemify Pro accesses your music library to analyze songs."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.stemify.pro",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-av",
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ed7b9358-8800-40cd-a43e-346813df1893"
      }
    },
    "owner": "makamsrujan"
  }
}
