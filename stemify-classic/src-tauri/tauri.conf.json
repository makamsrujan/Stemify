{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stemify",
  "version": "1.0.0",
  "identifier": "com.stemify.music",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "windows": [
      {
        "title": "Stemify",
        "url": "index.html",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon-192.png",
      "icons/icon-512.png"
    ],
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  }
}
